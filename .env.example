# PostHog — visitor analytics, click & scroll tracking, drop-off funnels.
# Sign up at https://posthog.com, create a project, copy values from
# Settings → Project → API keys.

# Project API key (browser-safe, starts with phc_).
NEXT_PUBLIC_POSTHOG_KEY=

# Region host. Use https://us.i.posthog.com or https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Personal API key (server-only, starts with phx_). Used by Claude / scripts
# to query event data via HogQL. Settings → Personal → Personal API keys.
# DO NOT prefix with NEXT_PUBLIC_ — this must never reach the browser.
POSTHOG_PERSONAL_API_KEY=

# Numeric project ID (visible in the project URL: /project/<id>/).
POSTHOG_PROJECT_ID=
